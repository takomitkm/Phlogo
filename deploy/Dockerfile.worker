# syntax=docker/dockerfile:1
# Multi-stage Rust build: worker binary (p7-01).
FROM rust:1.83-slim AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY apps ./apps
COPY migrations ./migrations
RUN cargo build --release --bin worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/worker /app/worker
COPY migrations /app/migrations
ENV PAILY_DATABASE_DSN=postgres://paily:change-me@postgres:5432/paily
ENV PAILY_DATABASE_JOBS_DSN=postgres://paily:change-me@postgres:5432/paily_jobs
ENTRYPOINT ["/app/worker"]
