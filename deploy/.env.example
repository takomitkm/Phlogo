# phlogo deployment environment (copy to .env and fill in real secrets)
POSTGRES_PASSWORD=change-me
SERVICE_SECRET=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
# M1: 32-byte key sealing node payloads at rest (credentials live inside them).
# Generate one:  openssl rand -hex 32      (hex)  or  openssl rand -base64 32
# Losing/changing this key makes existing payloads unreadable until sources are re-fetched.
PAYLOAD_KEY=
# M2: MiaoSpeed endpoint used by the worker for real checks.
# Without these the check run fails fast (status=failed), it never fakes success.
CHECKER_WS_URL=ws://miaospeed:65432/
CHECKER_SECRET=
# Optional: Clash (default, payload = one Clash proxy object) or Local.
# CHECKER_VENDOR=Clash
# Optional overrides (defaults in compose.yaml):
# MIAOSPEED_TAG=4.7.9
# WEB_IMAGE=nginx:alpine
# APALIS_BOARD_IMAGE=
