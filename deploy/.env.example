# phlogo deployment environment (copy to .env and fill in real secrets)
POSTGRES_PASSWORD=change-me
SERVICE_SECRET=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
# M1: 32-byte key sealing node payloads at rest (credentials live inside them).
# Generate one:  openssl rand -hex 32      (hex)  or  openssl rand -base64 32
# Losing/changing this key makes existing payloads unreadable until sources are re-fetched.
PAYLOAD_KEY=
# Optional overrides (defaults in compose.yaml):
# MIAOSPEED_TAG=4.7.9
# WEB_IMAGE=nginx:alpine
# APALIS_BOARD_IMAGE=
